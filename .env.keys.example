# Szablon lokalnego pliku z kluczami zespołu.
# Skopiuj:  cp .env.keys.example .env.keys
# Plik .env.keys NIE trafia do gita. Wartości dostajesz od Janka, Oli lub Jakuba (HackTribe / czat zespołu).
#
# Po uzupełnieniu skopiuj sekcje do:
#   ai/.env      — zmienne LLM_* i SUPABASE_* (patrz docs/KLUCZE.md)
#   web/.env     — gdy Ola postawi front (NEXT_PUBLIC_* i Resend)

# --- AI (/ai) — Janek + Ola ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=
DEMO_MODE=1

# --- Web (/web) — Ola + Jakub ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AI_URL=
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
