# Małopolski Hub Innowacji Społecznych — environment variables (AGENTS.md §3)
#
# This file is the TEMPLATE. It is the only .env* file in git, and every value here is empty.
# Real keys go in files that .gitignore already excludes — they are never committed:
#
#   web/.env.local   ← the "web" block below   (Next.js loads it automatically)
#   ai/.env          ← the "ai" block below    (Janek's FastAPI service)
#   .env             ← repo root, for `npm run seed`
#
# Verify any time with:  git check-ignore -v .env web/.env.local
# In production the same values are set in the Vercel / Render dashboards, not in files.
#
# Only genuinely public values may use the NEXT_PUBLIC_ prefix — NEXT_PUBLIC_* is inlined
# into the browser bundle and is readable by anyone who opens devtools.
#
# SUPABASE KEYS: use the CURRENT key model (Dashboard → Settings → API Keys), not the
# "Legacy API keys" tab. Supabase deprecates the old anon / service_role JWTs end of 2026.
#   sb_publishable_...  browser-safe        (replaces the anon key)
#   sb_secret_...       server-side only    (replaces the service_role key, bypasses RLS)
#
# The two var names below still say ANON / SERVICE_ROLE. That is deliberate: /ai, render.yaml,
# .env.keys and docs/KLUCZE.md already use them, and renaming mid-hackathon would break a
# deployed service for no functional gain. Old names, NEW sb_... values.

# ---------------------------------------------------------------- web (/web, Vercel)

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Paste the PUBLISHABLE key here (sb_publishable_...) — safe to ship in the browser.
# NOTE: RLS is off in this prototype, so this key can read AND write every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paste the SECRET key here (sb_secret_...) — SERVER-SIDE ONLY. Bypasses RLS, full DB access.
# Must never be NEXT_PUBLIC_-prefixed and never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the FastAPI service, no trailing slash. Live: https://ha-katon.onrender.com
# That service has to allow this app's origin (ALLOWED_ORIGINS on Render) — /web calls it
# straight from the browser, so a narrow value silently degrades every AI answer.
NEXT_PUBLIC_AI_URL=

# Resend API key, used by app/api/notify/route.ts. If missing, notify logs and returns ok.
RESEND_API_KEY=

# Inbox that receives "Nowe zgłoszenie" emails
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------- ai (/ai, Render/Railway)

# Same Supabase project as above (server-side, so no NEXT_PUBLIC_ prefix)
SUPABASE_URL=

# Same sb_secret_ key as SUPABASE_SERVICE_ROLE_KEY above. Ideally create a SEPARATE secret key
# for /ai in the dashboard — the new keys are individually revocable, so one leak does not
# force you to rotate everything mid-demo.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider credentials and model ids
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Comma-separated web origins allowed by CORS, e.g. https://hubmi.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# Set to 1 to serve cached answers for the exact demo-story inputs (agents/janek.md task 7)
DEMO_MODE=

# ---------------------------------------------------------------- scripts (root .env, seeding)
# scripts/seed.ts reads SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY from a root .env (gitignored).
