# Małopolski Hub Innowacji Społecznych — environment variables (AGENTS.md §3)
#
# Copy the "web" block to web/.env.local and the "ai" block to ai/.env — both are gitignored.
# NEVER commit real keys. Only genuinely public values may use the NEXT_PUBLIC_ prefix,
# because NEXT_PUBLIC_* is inlined into the browser bundle.

# ---------------------------------------------------------------- web (/web, Vercel)

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe in the browser, respects RLS (which is off for the prototype)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-SIDE ONLY. Full DB access, bypasses RLS.
# Must never be prefixed NEXT_PUBLIC_ and never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of Janek's FastAPI service, e.g. https://hubmi-ai.onrender.com (no trailing slash)
NEXT_PUBLIC_AI_URL=

# Resend API key, used by app/api/notify/route.ts. If missing, notify logs and returns ok.
RESEND_API_KEY=

# Inbox that receives "Nowe zgłoszenie" emails
ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------- ai (/ai, Render/Railway)

# Same Supabase project as above (server-side, so no NEXT_PUBLIC_ prefix)
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY= — same value as the web block above

# LLM provider credentials and model ids
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Comma-separated web origins allowed by CORS, e.g. https://hubmi.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# Set to 1 to serve cached answers for the exact demo-story inputs (agents/janek.md task 7)
DEMO_MODE=

# ---------------------------------------------------------------- scripts (root, seeding)
# scripts/seed.ts reads SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY from a root .env
